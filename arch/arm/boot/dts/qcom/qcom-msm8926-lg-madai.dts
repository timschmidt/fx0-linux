/dts-v1/;

#include "qcom-msm8226.dtsi"
#include "pm8226.dtsi"
#include <dt-bindings/gpio/gpio.h>

/delete-node/ &smem_region;

/ {
	model = "LG Fx0";
	compatible = "lg,madai", "qcom,msm8926", "qcom,msm8226";
	chassis-type = "handset";

	aliases {
		serial0 = &blsp1_uart3;
	};

	chosen {
		stdout-path = "serial0";
	};

	cam_vio: regulator-camera-io {
		compatible = "regulator-fixed";
		regulator-name = "cam_io_1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&tlmm 64 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <1000>;
		off-on-delay-us = <10000>;
	};

	reserved-memory {
		fx0_wcnss_mem: wcnss@d200000 {
			reg = <0x0d200000 0xa00000>;
			no-map;
		};

		/* Stock firmware excludes 5 MiB here; the first MiB is SMEM. */
		reserved@fb00000 {
			reg = <0x0fb00000 0x400000>;
			no-map;
		};

		smem_region: smem@fa00000 {
			reg = <0x0fa00000 0x100000>;
			no-map;
		};
	};
};

&cci {
	status = "okay";
};

&blsp1_uart3 {
	status = "okay";
};

&mba_region {
	status = "okay";
};

&mpss_region {
	status = "okay";
};

&pm8226_vadc {
	channel@6 {
		reg = <VADC_VBAT_SNS>;
		label = "vbat_sns";
	};

	channel@30 {
		reg = <VADC_LR_MUX1_BAT_THERM>;
		label = "batt_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
	};
};

&rpm_requests {
	regulators {
		compatible = "qcom,rpm-pm8226-regulators";

		pm8226_l4: l4 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-allow-set-load;
		};

		pm8226_l6: l6 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-always-on;
			regulator-allow-set-load;
		};

		pm8226_l8: l8 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			/* Also supplies the CPU PLL. */
			regulator-always-on;
			regulator-allow-set-load;
		};

		pm8226_l10: l10 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};

		pm8226_l17: l17 {
			regulator-min-microvolt = <2950000>;
			regulator-max-microvolt = <2950000>;
			regulator-always-on;
			regulator-allow-set-load;
		};

		pm8226_l20: l20 {
			regulator-min-microvolt = <3075000>;
			regulator-max-microvolt = <3075000>;
		};

		pm8226_l28: l28 {
			regulator-min-microvolt = <3100000>;
			regulator-max-microvolt = <3100000>;
			regulator-allow-set-load;
		};
	};
};

&sdhc_1 {
	vmmc-supply = <&pm8226_l17>;
	vqmmc-supply = <&pm8226_l6>;

	bus-width = <8>;
	non-removable;
	max-frequency = <200000000>;
	mmc-hs200-1_8v;
	mmc-ddr-1_8v;

	status = "okay";
};

&smbb {
	qcom,fast-charge-safe-current = <1500000>;
	qcom,fast-charge-current-limit = <1200000>;
	qcom,fast-charge-safe-voltage = <4380000>;
	qcom,fast-charge-high-threshold-voltage = <4350000>;
	qcom,auto-recharge-threshold-voltage = <4280000>;
	qcom,minimum-input-voltage = <4350000>;

	status = "okay";
};

&usb {
	extcon = <&smbb>;
	dr_mode = "peripheral";
	status = "okay";
};

&usb_hs_phy {
	extcon = <&smbb>;
	v1p8-supply = <&pm8226_l10>;
	v3p3-supply = <&pm8226_l20>;
};

&blsp1_i2c5 {
	status = "okay";

	touchscreen@20 {
		compatible = "syna,rmi4-i2c";
		reg = <0x20>;
		interrupt-parent = <&tlmm>;
		interrupts = <17 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&tlmm 16 GPIO_ACTIVE_LOW>;
		vdd-supply = <&pm8226_l28>;
		vio-supply = <&pm8226_l6>;
		syna,startup-delay-ms = <60>;
		#address-cells = <1>;
		#size-cells = <0>;

		rmi4-f01@1 {
			reg = <0x01>;
			syna,nosleep-mode = <2>;
		};

		rmi4-f12@12 {
			reg = <0x12>;
			syna,sensor-type = <1>;
		};
	};
};

&mdss {
	status = "okay";
};

&mdss_dsi0 {
	vdd-supply = <&pm8226_l28>;
	vdda-supply = <&pm8226_l4>;
	vddio-supply = <&pm8226_l8>;

	panel@0 {
		compatible = "lg,fx0-panel";
		reg = <0>;
		vdd-supply = <&pm8226_l28>;
		reset-gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
		io-enable-gpios = <&tlmm 113 GPIO_ACTIVE_HIGH>;
		positive-enable-gpios = <&tlmm 111 GPIO_ACTIVE_HIGH>;
		negative-enable-gpios = <&tlmm 112 GPIO_ACTIVE_HIGH>;
		backlight = <&pm8226_wled>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel_in>;
};

&mdss_dsi0_phy {
	vddio-supply = <&pm8226_l8>;
};

&pm8226_1 {
	pm8226_wled: wled@d800 {
		compatible = "qcom,pm8941-wled";
		reg = <0xd800>;
		label = "backlight";
		qcom,cs-out;
		qcom,current-limit = <20>;
		qcom,current-boost-limit = <805>;
		qcom,switching-freq = <800>;
		qcom,ovp = <35>;
		qcom,enabled-strings = <0>;
		default-brightness = <512>;
	};
};

&mdp_iommu {
	status = "okay";
};

&mdss_mdp {
	iommus = <&mdp_iommu 0>;
};
