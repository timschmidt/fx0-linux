/dts-v1/;

#include "qcom-msm8226.dtsi"
#include "pm8226.dtsi"

/ {
	model = "LG Fx0";
	compatible = "lg,madai", "qcom,msm8926", "qcom,msm8226";
	chassis-type = "handset";

	aliases {
		serial0 = &blsp1_uart3;
	};

	chosen {
		stdout-path = "serial0";
	};
};

&blsp1_uart3 {
	status = "okay";
};

&usb {
	status = "okay";
};

