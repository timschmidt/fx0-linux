/*
 * Battery thermistor lookup data: Copyright (c) 2012-2014, The Linux Foundation.
 * From the LG charging-temperature table in qpnp-adc-common.c, vendor revision
 * 03aba4427a7666d57b5ae06d375e259ea337f351. Temperatures are mC, ADC values mV.
 * This describes the original Fx0 pack; it does not select a capacity profile.
 */

/ {
	battery_thermistor: battery-thermistor {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0>;
		#io-channel-cells = <0>;
		io-channels = <&pm8226_vadc VADC_LR_MUX1_BAT_THERM>;
		io-channel-names = "sensor-channel";
		temperature-lookup-table = <
			(-30000) 1627
			(-20000) 1507
			(-10000) 1345
			0 1159
			1000 1139
			2000 1120
			3000 1101
			4000 1082
			5000 1064
			6000 1045
			7000 1026
			8000 1008
			9000 989
			10000 972
			11000 954
			12000 936
			13000 919
			14000 902
			15000 885
			16000 869
			17000 853
			18000 837
			19000 822
			20000 807
			21000 792
			22000 777
			23000 763
			24000 750
			25000 737
			26000 724
			27000 711
			28000 699
			29000 687
			30000 675
			31000 664
			32000 653
			33000 643
			34000 633
			35000 623
