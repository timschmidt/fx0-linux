			42000 562
			43000 555
			44000 547
			45000 540
			46000 533
			47000 527
			48000 521
			49000 515
			50000 509
			51000 503
			52000 498
			53000 492
			54000 487
			55000 482
			56000 478
			57000 473
			58000 469
			59000 465
			60000 461
			61000 457
			62000 453
			63000 449
			64000 446
			65000 442
			66000 439
			67000 436
			68000 433
			69000 430
			70000 427
			71000 425
			72000 422
			73000 420
			74000 417
			75000 415
			76000 413
			77000 411
			78000 409
			79000 407
		>;
	};

	thermal-zones {
		battery-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&battery_thermistor>;
		};
	};
};

&pm8226_0 {
	battery@4000 {
		io-channels = <&pm8226_iadc 1>, <&pm8226_iadc 3>,
			      <&pm8226_iadc 5>, <&pm8226_vadc VADC_VBAT_SNS>,
			      <&battery_thermistor>;
		io-channel-names = "current", "gain", "offset", "voltage", "temperature";
	};
};
